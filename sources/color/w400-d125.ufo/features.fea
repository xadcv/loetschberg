ntilde.hand ograve.hand oacute.hand ocircumflex.hand otilde.hand odieresis.hand divide.hand oslash.hand ugrave.hand uacute.hand ucircumflex.hand udieresis.hand yacute.hand thorn.hand ydieresis.hand dotlessi.hand];
