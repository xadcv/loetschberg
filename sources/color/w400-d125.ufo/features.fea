feature ss01 {
  featureNames { name "Handdrawn"; };
  sub @base by @hand;
  sub @ext by @hand_ext;
} ss01;
feature ss02 {
  featureNames { name "Extruded"; };
  sub @base by @ext;
  sub @hand by @hand_ext;
} ss02;
feature kern {
  pos L Odieresis -55;
  pos L.hand Odieresis.hand -55;
  pos L.ext Odieresis.ext -55;
  pos L.hand.ext Odieresis.hand.ext -55;
  pos T S -55;
  pos T.hand S.hand -55;
  pos T.ext S.ext -55;
  pos T.hand.ext S.hand.ext -55;
  pos R G -55;
  pos R.hand G.hand -55;
  pos R.ext G.ext -55;
  pos R.hand.ext G.hand.ext -55;
} kern;
